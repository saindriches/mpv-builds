# Pinned build inputs for mpv-builds. Human-readable record; keep in sync with
# .github/workflows/build.yml (the workflow currently reads these from its own env).
#
# We build mpv (the player app: mpv.app on macOS, mpv.exe on Windows, the binary on Linux) against an
# FFmpeg compiled from our fork (saindriches/FFmpeg). It carries the bt1869_tlv demuxer (MMT/TLV,
# ITU-R BT.1869, ARIB STD-B32 and STD-B60) in-tree, so mpv plays Japanese ISDB-S3 4K/8K .mmts files
# natively. mpv's own source patches live in patches/mpv/.
#
# The pinned branch is bt1869-tlv-ci (2026-10-31): FFmpeg master of 2026-10-30 (92457ada), the
# four commits of the bt1869-tlv upstream series, and the AVS+ (AVS1-P16 "GuangDian") decoder work of
# mmt-tlv-avsplus as one commit (profile 0x48, which Chinese 1080i terrestrial broadcast uses and
# upstream FFmpeg refuses to decode). Rollbacks: bt1869-tlv-ci-2025-base 1216d32d (same demuxer on
# the 2025-12-02 fork base, lavc 62) or mmt-tlv-avsplus 059cd851 (SuperFashi's mmttlv demuxer plus
# our fixes): put the hash back below and in the workflow.

FFMPEG_REPO=saindriches/FFmpeg                              # our FFmpeg fork (base: master @ 2026-10-30)
FFMPEG_REF=42507c8a3abc1cc14f7fc6d9a0486462699fc80d         # bt1869-tlv-ci branch head; bump to re-sync
MPV_REF=master             # mpv git ref to build (master = nightly); pin a tag for a stable build
CACHE_EPOCH=1              # bump to force a full FFmpeg+mpv rebuild (busts the deps cache)
